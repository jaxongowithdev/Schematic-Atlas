  static List<QuizQuestion> getQuizQuestions() {
    return [
      // Electrical Category
      QuizQuestion(
        question: 'Which symbol represents a Fuse?',
        mode: QuizMode.symbolToName,
        correctAnswer: 1,
        options: [1, 2, 3, 8],
        explanation: 'A fuse is a safety device that protects circuits from overcurrent.',
        category: 'Electrical',
      ),
      QuizQuestion(
        question: 'What is the purpose of a Circuit Breaker?',
        mode: QuizMode.trueFalse,
        correctAnswer: 1, // true
        options: [1, 2],
        explanation: 'Circuit breakers automatically stop current flow when detecting faults or overloads.',
        category: 'Electrical',
      ),
      QuizQuestion(
        question: 'Select the symbol for a Motor',
        mode: QuizMode.nameToSymbol,
        correctAnswer: 4,
        options: [2, 4, 5, 6],
        explanation: 'Motors convert electrical energy into mechanical rotation.',
        category: 'Electrical',
      ),
      QuizQuestion(
        question: 'Which device converts mechanical energy to electrical energy?',
        mode: QuizMode.symbolToName,
        correctAnswer: 5,
        options: [4, 5, 6, 7],
        explanation: 'A generator converts mechanical energy into electricity.',
        category: 'Electrical',
      ),
      QuizQuestion(
        question: 'This symbol is a Transformer',
        mode: QuizMode.trueFalse,
        correctAnswer: 1,
        options: [1, 6],
        explanation: 'Transformers change voltage levels in AC circuits.',
        category: 'Electrical',
      ),

      // Mechanical Category
      QuizQuestion(
        question: 'Which symbol represents a Gear?',
        mode: QuizMode.symbolToName,
        correctAnswer: 11,
        options: [11, 12, 13, 14],
        explanation: 'Gears transmit torque and change rotational speed.',
        category: 'Mechanical',
      ),
      QuizQuestion(
        question: 'What supports rotating shafts?',
        mode: QuizMode.symbolToName,
        correctAnswer: 12,
        options: [11, 12, 13, 15],
        explanation: 'Bearings support rotating shafts and reduce friction.',
        category: 'Mechanical',
      ),
      QuizQuestion(
        question: 'Select the symbol for a Spring',
        mode: QuizMode.nameToSymbol,
        correctAnswer: 14,
        options: [11, 12, 14, 15],
        explanation: 'Springs store and release mechanical energy.',
        category: 'Mechanical',
      ),

      // Hydraulic Category
      QuizQuestion(
